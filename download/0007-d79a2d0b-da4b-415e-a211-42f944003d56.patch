+     1→"use client";
+     2→
+     3→// ─── KIT visor-masida-redesign-v1 — MODAL DE REVISIÓN REMODELADO ────────────
+     4→// Redesign Stitch («Supervisión de Actas Electorales — Auditoría y
+     5→// Escrutinio») aplicado al ABRIR de la bandeja masiva: workspace completo
+     6→// a 2 columnas — canvas del documento (toolbar flotante + chevrons de
+     7→// navegación entre imágenes procesadas + MOSTRAR ORIGINAL + franja de
+     8→// metadata) y panel del auditor a la derecha (ENVÍO AUTOMÁTICO con los
+     9→// datos reconocidos, OBSERVACIONES, ACCIONES DEL SUPERVISOR con RECHAZAR
+    10→// (REESCANEAR) y nota de auditoría).
+    11→//
+    12→// DISCIPLINA DE SIEMPRE — cero cambios de lógica, solo remodelación:
+    13→// · Contrato de props intacto (+2 props NUEVAS opcionales de navegación:
+    14→//   posNavegacion/onNavegar — el orquestador las alimenta con la bandeja).
+    15→// · El editor (RECORTAR/ROTAR/DESHACER horneados por canvas) sigue vivo
+    16→//   para las actas SIN envío automático — ahora vive en la toolbar. Para
+    17→//   las ENVIADAS AUTO la rotación es VISUAL (ayuda de lectura, no hornea).
+    18→// · Las ediciones siguen viajando por editarActaActual; la persistencia
+    19→//   sigue siendo sincronizarAlVolver al cerrar (store masiva, intacto).
+    20→// · RECHAZAR (nueva acción del supervisor): motivo OBLIGATORIO + armado a
+    21→//   2 toques (mismo patrón VACIAR/REINICIAR de la bandeja) → parchea el
+    22→//   acta abierta (status RECHAZADA + rechazo SUPERVISOR con el motivo) y
+    23→//   pasa al siguiente acta del lote. Nada del runner/store se toca.
+    24→// · Honestidad de datos (kit §1): score real, página real (o «- DE -») —
+    25→//   jamás inventar campos.
+    26→// · Feedback del dueño (ronda 1): VER EN MONITOR vive en la CABECERA del
+    27→//   panel (outline verde + monitor, solo con publicación aterrizada D27);
+    28→//   al fondo del panel queda SOLO CERRAR; campos del panel = exactamente
+    29→//   los del diseño (fuera Intento/Hash/IdEnlace); «Verificación de
+    30→//   Identificador / Código» = el código impreso ENTRE LAS X del acta
+    31→//   (7-23-10-19 — plancha del formulario E-14 exterior), NO el barcode;
+    32→//   móvil: el modal COMPLETO hace scroll (navegable) y AJUSTAR = canvas a
+    33→//   pantalla completa real (h-dvh).
+    34→import { useCallback, useEffect, useRef, useState } from "react";
+    35→import {
+    36→  AlertTriangle,
+    37→  Check,
+    38→  ChevronLeft,
+    39→  ChevronRight,
+    40→  CircleCheck,
+    41→  Contrast,
+    42→  Crop,
+    43→  Eye,
+    44→  EyeOff,
+    45→  Info,
+    46→  Loader2,
+    47→  Maximize,
+    48→  Minimize,
+    49→  Monitor,
+    50→  RotateCw,
+    51→  ShieldCheck,
+    52→  Undo2,
+    53→  X,
+    54→  ZoomIn,
+    55→  ZoomOut,
+    56→} from "lucide-react";
+    57→
+    58→import {
+    59→  joinDeActa,
+    60→  useE14Store,
+    61→  type PublicacionActa,
+    62→} from "@/modules/digitalizador/store/store-e14";
+    63→import type { Acta } from "@/modules/digitalizador/lib/e14/types";
+    64→// KIT editor-masiva-v1: horneado de ROTAR/RECORTAR por canvas (misma
+    65→// disciplina de siempre — canvas puro, dataURL out).
+    66→import {
+    67→  recortarDataUrl,
+    68→  rotateProcessedDataUrl,
+    69→} from "@/modules/digitalizador/lib/e14/image-utils";
+    70→// KIT visor-gestos-v1 (compartido con el visor del dashboard): zoom con
+    71→// rueda del mouse / pellizco táctil / arrastre — primitivo puro de UI.
+    72→import {
+    73→  VisorZoom,
+    74→  type VisorZoomHandle,
+    75→} from "@/modules/supervision/components/actas/visor-zoom";
+    76→import { pildoraEstadoActa } from "./helpers";
+    77→import { PublicacionChip } from "./publicacion-chip";
+    78→import type { PropsMasivaView } from "./orquestador";
+    79→
+    80→/** Rectángulo de recorte en % del área de la foto (0–100 — mapea a píxeles
+    81→ * naturales al aplicar; el drag llega saneado y el clamp lo respalda). */
+    82→interface RectPct {
+    83→  x: number;
+    84→  y: number;
+    85→  w: number;
+    86→  h: number;
+    87→}
+    88→
+    89→/** Mínimo % en CADA eje para habilitar APLICAR (evita recortes absurdos). */
+    90→const RECT_MIN_PCT = 3;
+    91→
+    92→/** Modos de contraste del visor (mismo trío del visor del dashboard). */
+    93→type ContrasteModo = "NORMAL" | "ALTO" | "NEGATIVO";
+    94→
+    95→const FILTRO_CONTRASTE: Record<ContrasteModo, string | undefined> = {
+    96→  NORMAL: undefined,
+    97→  ALTO: "contrast(1.4) brightness(1.05)",
+    98→  NEGATIVO: "invert(1)",
+    99→};
+   100→
+   101→/** Score honesto: entero sin decimales (10/10), el resto a 1 decimal. */
+   102→function scoreTexto(score: number): string {
+   103→  return Number.isInteger(score) ? String(score) : score.toFixed(1);
+   104→}
+   105→
+   106→/** «Verificación de Identificador / Código» (feedback del dueño): el código
+   107→ * IMPRESO del formulario E-14 exterior — el que aparece ENTRE LAS X en el
+   108→ * acta física («X 7-23-10-19 X», justo bajo el encabezado CONSULADO/PAÍS/
+   109→ * ZONA/PUESTO/MESA/LUGAR). Es el código de plancha del formulario (constante
+   110→ * verificada en las actas reales del CONSULADO 88 · PAÍS 335 Egipto · KIT
+   111→ * 399 y en las 6 fotos del dueño) — NO es el código de barras (ese vive en
+   112→ * su campo propio) y el pipeline no lo lee: se muestra tal cual va impreso. */
+   113→const CODIGO_FORMA_ENTRE_XX = "7 - 23 - 10 - 19";
+   114→
+   115→/** Etiqueta del formulario (misma convención del adaptador D27 —
+   116→ * store-e14.ts): TRANSMISION → «TRANSMISIÓN», DELEGADOS → «CÓNSUL/
+   117→ * EMBAJADOR». Sin clasificación → el tipo crudo del acta o «—». */
+   118→function etiquetaFormularioDe(acta: Acta): string {
+   119→  const t = acta.clasificacion?.tipo ?? acta.tipo;
+   120→  if (t === "TRANSMISION") return "TRANSMISIÓN";
+   121→  if (t === "DELEGADOS") return "CÓNSUL/EMBAJADOR";
+   122→  return t || "—";
+   123→}
+   124→
+   125→/** Etiqueta ORIGEN del panel (tipo de copia del acta). */
+   126→function origenDe(acta: Acta): string {
+   127→  const t = acta.clasificacion?.tipo ?? acta.tipo;
+   128→  if (t === "TRANSMISION") return "Transmisión";
+   129→  if (t === "DELEGADOS") return "Delegados";
+   130→  return t || "—";
+   131→}
+   132→
+   133→export function ModalRevisor({
+   134→  acta,
+   135→  publicacion,
+   136→  onVerEnMonitor,
+   137→  onCerrar,
+   138→  posNavegacion,
+   139→  onNavegar,
+   140→  cargarOriginal,
+   141→}: {
+   142→  acta: Acta | null;
+   143→  publicacion?: PublicacionActa;
+   144→  onVerEnMonitor?: PropsMasivaView["onVerEnMonitor"];
+   145→  onCerrar: () => void;
+   146→  /** Posición 1-based del acta abierta entre las imágenes LISTAS del lote
+   147→   * (null = fuera de la lista — chevrons sin destino). */
+   148→  posNavegacion?: { index: number; total: number } | null;
+   149→  /** Navegación entre imágenes procesadas (orquestador: sincroniza el acta
+   150→   * abierta y carga la vecina — misma puerta que ABRIR de la bandeja). */
+   151→  onNavegar?: (direccion: -1 | 1) => void;
+   152→  /** MOSTRAR ORIGINAL — materializa el archivo ORIGINAL del registro
+   153→   * (orquestador: FileReader del File en IDB). null si no hay archivo. */
+   154→  cargarOriginal?: (id: string) => Promise<string | null>;
+   155→}) {
+   156→  // ── Visor (estado del redesign — todo local, cero acople con el store) ──
+   157→  const [verOriginal, setVerOriginal] = useState(false);
+   158→  const [rotacionVisual, setRotacionVisual] = useState(0);
+   159→  const [contraste, setContraste] = useState<ContrasteModo>("NORMAL");
+   160→  const [expandido, setExpandido] = useState(false);
+   161→  const [escala, setEscala] = useState<number | null>(null);
+   162→  // MOSTRAR ORIGINAL: la foto cruda puede vivir en el acta (fotoOriginal),
+   163→  // en el archivo del registro (materialización on-demand) o no existir
+   164→  // (registros sin archivo — degradación honesta del toggle).
+   165→  const [originalUrl, setOriginalUrl] = useState<string | null>(null);
+   166→  const [cargandoOriginal, setCargandoOriginal] = useState(false);
+   167→  const [sinOriginal, setSinOriginal] = useState(false);
+   168→  // Espejo del expandido para el listener de Escape (lectura sin re-suscribir).
+   169→  const expandidoRef = useRef(false);
+   170→  useEffect(() => {
+   171→    expandidoRef.current = expandido;
+   172→  }, [expandido]);
+   173→  // Reporte de escala estable (VisorZoom llama onZoomChange en cada gesto).
+   174→  const onZoomChange = useCallback((e: number) => setEscala(e), []);
+   175→
+   176→  // Escape: pantalla completa sale primero; fuera de ella cierra el modal.
+   177→  useEffect(() => {
+   178→    if (!acta) return;
+   179→    const onKeyDown = (e: KeyboardEvent) => {
+   180→      if (e.key !== "Escape") return;
+   181→      if (expandidoRef.current) {
+   182→        setExpandido(false);
+   183→        return;
+   184→      }
+   185→      onCerrar();
+   186→    };
+   187→    document.addEventListener("keydown", onKeyDown);
+   188→    return () => document.removeEventListener("keydown", onKeyDown);
+   189→  }, [acta, onCerrar]);
+   190→
+   191→  // ── Editor (estado local del modal — el acta vive en useE14Store) ──────
+   192→  const foto = acta?.fotoProcesada ?? acta?.fotoOriginal ?? null;
+   193→  const editable = Boolean(acta && !acta.enviadoAutomaticamente && foto);
+   194→  const [editandoRecorte, setEditandoRecorte] = useState(false);
+   195→  const [rect, setRect] = useState<RectPct | null>(null);
+   196→  const [ocupado, setOcupado] = useState<null | "rotando" | "recortando">(null);
+   197→  const [editada, setEditada] = useState(false);
+   198→  const fotoPreEdicionRef = useRef<string | null>(null);
+   199→  const visorRef = useRef<VisorZoomHandle>(null);
+   200→  const zonaRecorteRef = useRef<HTMLDivElement>(null);
+   201→  const arrastreRef = useRef<{ x: number; y: number } | null>(null);
+   202→
+   203→  // ── Rechazo del supervisor (motivo obligatorio + armado a 2 toques) ────
+   204→  const [observaciones, setObservaciones] = useState("");
+   205→  const [errorMotivo, setErrorMotivo] = useState(false);
+   206→  const [rechazoArmado, setRechazoArmado] = useState(false);
+   207→  const [rechazoHecho, setRechazoHecho] = useState(false);
+   208→  const timerRechazoRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+   209→
+   210→  // Reset del visor/editor/rechazo al cambiar de acta abierta (navegación
+   211→  // incluida) — y del timer de avance pendiente.
+   212→  useEffect(() => {
+   213→    setEditandoRecorte(false);
+   214→    setRect(null);
+   215→    setOcupado(null);
+   216→    setEditada(false);
+   217→    fotoPreEdicionRef.current = null;
+   218→    setVerOriginal(false);
+   219→    setOriginalUrl(null);
+   220→    setCargandoOriginal(false);
+   221→    setSinOriginal(false);
+   222→    setRotacionVisual(0);
+   223→    setContraste("NORMAL");
+   224→    setRechazoArmado(false);
+   225→    setRechazoHecho(false);
+   226→    setErrorMotivo(false);
+   227→    setObservaciones("");
+   228→    if (timerRechazoRef.current) {
+   229→      clearTimeout(timerRechazoRef.current);
+   230→      timerRechazoRef.current = null;
+   231→    }
+   232→  }, [acta?.id]);
+   233→
+   234→  useEffect(
+   235→    () => () => {
+   236→      if (timerRechazoRef.current) clearTimeout(timerRechazoRef.current);
+   237→    },
+   238→    [],
+   239→  );
+   240→
+   241→  /** ROTAR: actas sin envío automático → HORNEA 90° (persiste en el acta);
+   242→   *  enviadas auto → rotación VISUAL del visor (ayuda de lectura). */
+   243→  const rotarFoto = async () => {
+   244→    if (!acta || !foto || ocupado) return;
+   245→    if (!editable) {
+   246→      setRotacionVisual((r) => (r + 90) % 360);
+   247→      return;
+   248→    }
+   249→    if (!fotoPreEdicionRef.current) fotoPreEdicionRef.current = foto;
+   250→    setEditandoRecorte(false);
+   251→    setRect(null);
+   252→    setOcupado("rotando");
+   253→    try {
+   254→      const r = await rotateProcessedDataUrl(foto, 90);
+   255→      useE14Store.getState().editarActaActual({ fotoProcesada: r.url });
+   256→      setEditada(true);
+   257→    } catch {
+   258→      /* horneado fallido — la foto queda como está (honesto, sin humo) */
+   259→    } finally {
+   260→      setOcupado(null);
+   261→    }
+   262→  };
+   263→
+   264→  /** APLICAR recorte — mapea el rect % → píxeles naturales y hornea. */
+   265→  const aplicarRecorte = async () => {
+   266→    if (!acta || !foto || !rect || ocupado) return;
+   267→    const img = zonaRecorteRef.current?.querySelector("img");
+   268→    if (!img || !img.naturalWidth || !img.naturalHeight) return;
+   269→    if (rect.w < RECT_MIN_PCT || rect.h < RECT_MIN_PCT) return;
+   270→    const natRect = {
+   271→      x: (rect.x / 100) * img.naturalWidth,
+   272→      y: (rect.y / 100) * img.naturalHeight,
+   273→      w: (rect.w / 100) * img.naturalWidth,
+   274→      h: (rect.h / 100) * img.naturalHeight,
+   275→    };
+   276→    if (!fotoPreEdicionRef.current) fotoPreEdicionRef.current = foto;
+   277→    setOcupado("recortando");
+   278→    try {
+   279→      const r = await recortarDataUrl(foto, natRect);
+   280→      useE14Store.getState().editarActaActual({ fotoProcesada: r.url });
+   281→      setEditada(true);
+   282→      setEditandoRecorte(false);
+   283→      setRect(null);
+   284→    } catch {
+   285→      /* horneado fallido — la foto queda como está (honesto, sin humo) */
+   286→    } finally {
+   287→      setOcupado(null);
+   288→    }
+   289→  };
+   290→
+   291→  /** DESHACER — devuelve la foto del momento ANTES de la primera edición. */
+   292→  const deshacerEdicion = () => {
+   293→    const original = fotoPreEdicionRef.current;
+   294→    if (!original || ocupado) return;
+   295→    useE14Store.getState().editarActaActual({ fotoProcesada: original });
+   296→    setEditada(false);
+   297→    fotoPreEdicionRef.current = null;
+   298→    setEditandoRecorte(false);
+   299→    setRect(null);
+   300→  };
+   301→
+   302→  /** MOSTRAR ORIGINAL — alterna procesada ↔ cruda. La cruda viene del acta
+   303→   *  (fotoOriginal) o se materializa del archivo del registro on-demand. */
+   304→  const alternarOriginal = async () => {
+   305→    if (cargandoOriginal || !acta) return;
+   306→    if (verOriginal) {
+   307→      setVerOriginal(false);
+   308→      return;
+   309→    }
+   310→    if (acta.fotoOriginal || originalUrl) {
+   311→      setVerOriginal(true);
+   312→      return;
+   313→    }
+   314→    if (!cargarOriginal) {
+   315→      setSinOriginal(true);
+   316→      return;
