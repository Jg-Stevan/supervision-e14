@@ -89,7 +89,14 @@
   --radius-lg: var(--radius);
   --radius-xl: var(--radius);
 
-  /* Fuentes: estructura = Hanken Grotesk, datos = JetBrains Mono */
+  /* Fuentes: estructura = Hanken Grotesk, datos = JetBrains Mono.
+     PREVIEW: next/font/google no está disponible en este entorno — las
+     variables caen a stacks de sistema equivalentes (el día del merge al
+     repo real, next/font vuelve a definirlas y este bloque sobra). */
