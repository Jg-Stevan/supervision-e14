# Dependencias y build
node_modules
.next
out
dist
build
.wrangler
.vercel
coverage
*.tsbuildinfo
next-env.d.ts

# Generados por `bun run preparar` (scripts/build-capa0-worker.mjs y
# scripts/sincronizar-vendor.mjs). NO se versionan: el worker emite desde su
# .ts en cada build y el wasm de onnxruntime-web es copia del paquete que ya
# baja `bun install`. Los workflows corren `bun run build`, que dispara el
# hook `prebuild`.
public/scanner/capa0-qr.worker.js
public/vendor/onnxruntime/

# Sidecar nativo: se versiona el código (native/*.py), no lo que produce
native/__pycache__/
native/calentamiento/
native/out*/
native/final*/
native/montage_*.png
native/antes_*.png
native/*.json
/dist/
/.venv-sidecar/
*.spec

# Evidencia de corridas locales: scripts/bench-navegador.mjs escribe
# bench-navegador-<tag>.json con los tiempos crudos y el texto OCR de las actas
# del dueño. Es dato de sesión (y contiene nombres leídos de actas reales):
# nunca al repo.
/bench-navegador-*.json
/out/fotos*/

# Logs y estado local del entorno de desarrollo
*.log
*.pid
.env*
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Herramientas de agentes / skills locales
/skills/
.z-ai-config
.claude
local-*
